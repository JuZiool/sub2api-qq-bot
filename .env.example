# ===== OneBot（NapCat）连接 =====
# NapCat WebSocket 服务端地址（docker compose 内用服务名）
ONEBOT_WS_URL=ws://napcat:3001
# NapCat 配置的 access token，未设置可留空
ONEBOT_ACCESS_TOKEN=

# ===== sub2api 管理 API =====
# sub2api 服务地址（本机部署可写 http://host.docker.internal:8080）
SUB2API_BASE_URL=http://host.docker.internal:8080
# 注意：sub2api 登录使用管理员邮箱
SUB2API_ADMIN_EMAIL=admin@example.com
SUB2API_ADMIN_PASSWORD=changeme

# ===== 本地数据目录 =====
# 建议使用项目目录之外的绝对路径，重新部署代码时数据不会丢失
NAPCAT_DATA_DIR=/opt/sub2api-qq-bot-data/napcat
QQ_DATA_DIR=/opt/sub2api-qq-bot-data/qq
BOT_DATA_DIR=/opt/sub2api-qq-bot-data/bot
# ===== 机器人行为 =====
# 指令前缀，默认 /
BOT_COMMAND_PREFIX=/
# 允许使用管理查询指令的 QQ 号，逗号分隔；留空表示不限制（不推荐）
ADMIN_QQ_LIST=10000,10001
# 是否响应群聊（true/false）
RESPOND_GROUP=true
# 是否响应私聊（true/false）
RESPOND_PRIVATE=true
